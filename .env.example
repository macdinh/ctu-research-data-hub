# ============================================================================
# CẤU HÌNH MÔI TRƯỜNG (SUPABASE + CLOUDFLARE R2)
# Sao chép file này thành .env.local và điền thông tin từ Dashboard của bạn
# ============================================================================

# 1. Supabase Configuration (Database PostgreSQL & Authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Cloudflare R2 Configuration (S3-Compatible Object Storage cho Dataset lớn)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ctu-research-datasets
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
